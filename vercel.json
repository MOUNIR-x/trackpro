{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/client",
      "destination": "/client.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}
